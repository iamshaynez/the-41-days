# 复制为 .env（本地开发可选；生产用环境变量注入，勿提交 .env）
# 服务
PORT=3000
NODE_ENV=development
# 数据库（migrate 与 server 共用同一配置）
DB_PATH=data/game.db
# 管理员账号（首次用这组凭据登录即自动创建管理员；环境变量凭据永远优先）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=war-admin
# 日志级别 debug|info|warn|error
LOG_LEVEL=debug
# 对局输入限流（次/分钟/IP，0=关闭）
INPUT_RATE_PER_MIN=120
# 会话有效期（小时）
SESSION_TTL_HOURS=24
# 备份保留份数（npm run backup）
BACKUP_KEEP=10
