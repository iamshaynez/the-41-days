      "traits": { "negotiate": 0.05, "craftAdv": true },
      "ethics": { "stealCiv": 1.2, "killCiv": 1.5, "killEnemy": 1.2, "help": 0.8 },
      "frail": true, "desc": "教了一辈子书，现在算的是还剩几顿饭。",
      "persona": {
        "epithet": "用秩序对抗崩塌",
        "knot": "女儿在公安，等他去找",
        "taboo": "绝不烧字纸",
        "sensitive": { "burn_book": 3, "deny_food": 1.5 },
        "protests": [
          { "verb": "burn_book", "mood": -2, "oncePerDay": true, "line": "烧一枚是一枚。你们烧的不是竹，是有人写过字的时间。" }
        ],
        "voice": [
          "账不是这么算的。账是：他们还在，我们就还欠着。",
          "竹会烧，手会洗。记在心里，心不死。",
          "我教了四十年书，只学会一件事：先把人算上，再算别的。"
        ]
      }
    },
