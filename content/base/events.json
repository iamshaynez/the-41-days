    {
      "id": "s_rhythm_face",
      "kind": "script",
      "for": "loc:frontline",
      "when": {
        "requiresFlag": "crossing_heard",
        "requiresChar": "zofia"
      },
      "title": "箭楼下",
      "text": "走近了才看清：箭楼上的人很年轻，箭壶空了一半，照着一页抄来的节奏表放箭。素徽在你身后，呼吸没有声音。",
      "options": [
        {
          "key": "fight",
          "label": "强攻箭楼（让渡口从此安静）",
          "riskCheck": {
            "difficulty": 8,
            "combat": true,
            "onPass": {
              "npcState": {
                "bailing": "down"
              },
              "mood": {
                "zofia": -6
              },
              "knowledge": 1,
              "flags": {
                "bailing_dead": true
              },
              "text": "箭楼安静了。渡口从此能过人。素徽没有看台上，她看着江——她找到的不是哥哥，现在连遗物也没有了。"
            },
            "onFail": {
              "combat": "bailing",
              "text": "他按拍子放箭，比你想的快。"
            }
          }
        },
        {
          "key": "detour",
          "label": "绕行（渡口的箭继续替别人守着）",
          "effects": {
            "flags": {
              "crossing_detour": true
            },
            "text": "你们绕着射界走完了这一夜。身后箭声没有停，三短，一长，像在给谁数更。"
          }
        },
        {
          "key": "leave",
          "label": "退回去",
          "effects": {
            "abortNight": true
          }
        }
      ]
    },
    {
      "id": "s_rhythm_gift",
      "kind": "script",
      "for": "loc:frontline",
      "when": {
        "requiresChar": "zofia",
        "requiresFlag": "crossing_heard",
        "requiresDoc": "#028"
      },
      "title": "把鼓谱送过去",
      "text": "素徽从怀里取出那页鼓谱残页——地窖暗格里的那张。\"照死人鼓谱放箭的人，\"她把鼓谱绑上箭，\"看到原作者的笔迹，会停下来想一想自己在念什么。\"箭楼方向的箭声还在按拍子走。",
      "options": [
        {
          "key": "gift",
          "label": "射过去",
          "riskCheck": {
            "difficulty": 8,
            "onPass": {
              "flags": {
                "crossing_hushed_until": "+1",
                "crossing_gift": true
              },
              "mood": {
                "zofia": 2
              },
              "knowledge": 1,
              "text": "箭落在射界里。很久，箭楼没有声音。然后你听见了：不是箭声，是一段被埙吹奏的、走调的旋律——他在照着念，第一次念对了换气的地方。今夜，渡口没有箭声。"
            },
            "onCost": {
              "flags": {
                "crossing_hushed_until": "+1",
                "crossing_gift": true
              },
              "text": "箭擦着墙落进射界。箭声停了半拍——只有半拍，但那半拍里有人犹豫了。今夜渡口大概安全。"
            },
            "onFail": {
              "text": "箭还没离弦，箭声先响了。你把她按回掩体，流矢咬在你们头顶的夯土上，按着《蒿里》的拍子。"
            }
          }
        },
        {
          "key": "leave",
          "label": "把鼓谱收好，今晚先撤",
          "effects": {
            "abortNight": true
          }
        }
      ]
    },
    {
      "id": "t_lighthouse",
      "kind": "internal",
      "weight": 10,
      "when": {
        "knowledge": 12,
        "requiresDocs": [
          "#039",
          "#045",
          "#055"
        ],
        "requiresChar": "alexey",
        "requiresFacility": "radio",
        "minDay": 10,
        "chance": 1,
        "once": false,
        "cooldown": 4
      },
      "title": "还师：烽鼓具齐备了",
      "actor": "alexey",
      "text": "逄灶把最后一面鼓架上，火篮试了火。三份铁证摊在桌上：魏吴券书抄件、誊抄所底稿、屯候更籍抄件。\"今晚可以把真相送过三道津戍，送上北津台。\"他看着你，\"想清楚——鼓声响出去，就收不回来。\"",
      "options": [
        {
          "key": "launch",
          "label": "启动《还师》：今夜把铁证送上烽台",
          "effects": {
            "flags": {
              "lighthouse_day": "+3"
            },
            "mood": {
              "all": 5
            },
            "text": "逄灶开始整理干薪与艾。白简若在，他会写下露布的第一句话；不在，你自己写。三天后，全城的城门都会贴满。"
          }
        },
        {
          "key": "wait",
          "label": "再等等",
          "effects": {
            "flags": {
              "lighthouse_declined": true
            }
          }
        }
      ]
    },
    {
      "id": "t_table_offer",
      "kind": "internal",
      "weight": 8,
      "when": {
        "requiresAnyDoc": [
          "#033",
          "#052"
        ],
        "minDay": 20,
        "chance": 1,
        "once": false,
        "cooldown": 5
      },
      "title": "鲁舟的非正式拜访",
      "actor": "franko",
      "text": "鲁舟收摊没走。黄昏里他压低了斗笠：\"你手里那些纸……有人愿意出大价钱。一条下江的船，三张符传，全家都上得去。条件是沉默。\"他的手在抖，\"我见过接受的人后来去了哪。但我还是得问。\"",
      "options": [
        {
          "key": "accept",
          "label": "接受：船与符传，代价是沉默",
          "effects": {
            "flags": {
              "join_table": true
            },
            "text": "鲁舟没敢看你的眼睛。\"逢双日，\"他说，\"船在江津。\"你活着离开了江陵。江陵没有。"
          }
        },
        {
          "key": "refuse",
          "label": "拒绝",
          "effects": {
            "flags": {
              "refused_table": true,
              "franko_gone": true
            },
            "mood": {
              "all": 1
            },
            "text": "鲁舟点点头，像早就知道。他解缆撑船，消失在江雾里——从那以后，再也没人在逢双日泊过这道渡口。"
          }
        }
      ]
    },
    {
      "id": "alt_jiangling",
      "kind": "internal",
      "weight": 0,
      "when": {
        "chance": 0,
        "maxDay": 30
      },
      "title": "火线：证据交给谁",
      "actor": "player",
      "text": "大仓火场的勘验和太守府长史的手令残牍都在你手里——烧军械的火，是守城的人自己下的订单。这种事，报给军正，会死无葬身之地；烧了，一了百了。\n还有第三条路：治中潘濬闭门不出，但他府上收里社渠道递进去的死信。你不放心过文修的手——可全城只有这条渠道，接得住这份纸。",
      "options": [
        {
          "key": "deliver",
          "label": "通过里社，递进治中府",
          "effects": {
            "flags": {
              "alt_jiangling": true
            },
            "knowledge": 2,
            "mood": {
              "all": 2
            },
            "text": "三天后，军正府的人盯上了太守府的长史。没人被捕，没人喊冤，但纪南大仓再没着过第二把火，北津门的门轴干得发涩。城还在原轨上——只是那扇备好的门，没了。"
          }
        },
        {
          "key": "burn",
          "label": "烧了它，这种事不该落在小人物手里",
          "effects": {
            "mood": {
              "all": -1
            },
            "flags": {
              "alt_burned": true
            },
            "text": "灰飘出院子的时候，你觉得自己听见有人在很远的地方打算盘。"
          }
        }
      ]
    },
    {
      "id": "alt_maicheng_drum",
      "kind": "internal",
      "weight": 0,
      "when": {
        "chance": 0,
        "eveOfWarEnd": true
      },
      "title": "交割前夜：北津台的鼓",
      "actor": "zofia",
      "text": "明天城就要开了——你们都知道。素徽站在窗边听了很久：「鼓要是从北津台响起来，樊城能早一夜听见。」逄灶在擦火镰，没抬头：「台我能修。鼓她能敲。」他顿了顿，「就一夜。」\n（选了这个，黄昏就把人派去北津台。）",
      "options": [
        {
          "key": "go",
          "label": "上北津台：修台、举火、照鼓谱击鼓",
          "effects": {
            "flags": {
              "alt_maicheng_attempt": true
            },
            "text": "黄昏就去。逄灶午后已经先去看了台基——台上的活计，只有今夜。"
          }
        },
        {
          "key": "stay",
          "label": "守在家里",
          "effects": {
            "mood": {
              "all": -1
            },
            "text": "那一夜很静。你们都醒着，听塔的方向。"
          }
        }
      ]
    },
