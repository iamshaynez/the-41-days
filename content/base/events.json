    {
      "id": "n_veteran",
      "kind": "knock",
      "weight": 6,
      "when": {
        "phase": "any",
        "minDay": 6,
        "chance": 1,
        "cooldown": 14
      },
      "title": "敲门：老屯卒的灯",
      "actor": "neighbor",
      "text": "街口守义仓的老屯卒来讨半碗油——仓房的灯不能灭，他说，灭了仓里的鼠比兵还凶。他咳了一声：「不白喝你们的。江上的事，我看过十一年。」",
      "options": [
        {
          "key": "give",
          "label": "给他一碗膏油",
          "requires": {
            "item": "fuel"
          },
          "effects": {
            "consumeChoice": [
              "fuel"
            ],
            "mood": {
              "all": 2
            },
            "reputation": {
              "neighbor": 1
            },
            "flags": {
              "knows_frontline": true
            },
            "text": "他临走时往江的方向努了努嘴：「水门渡的旧垒，滩涂上全是没人敢去的东西。十一年的，今年的，都在那儿。」（新地点：水门渡旧垒）"
          }
        },
        {
          "key": "refuse",
          "label": "灯油金贵，回绝",
          "effects": {
            "mood": {
              "default": -1
            },
            "reputation": {
              "neighbor": -1
            }
          }
        }
      ]
    },
