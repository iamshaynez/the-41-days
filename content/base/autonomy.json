    "anton": {
      "trade": [
        {
          "id": "anton_teach",
          "line": "文简把简册摊开，教{{other}}认今天这三个字。教了一辈子书，手还是这个手。",
          "weight": 7,
          "once": "day",
          "do": "teach",
          "target": "student"
        },
        {
          "id": "anton_tale",
          "line": "文简讲古。讲的是围城之前的事——有人听着听着松了肩膀。",
          "weight": 4,
          "once": "run",
          "when": {
            "dayEvery": 3
          },
          "effects": {
            "mood": {
              "all": 1
            },
            "knowledge": 1
          }
        }
      ],
      "habits": [
        {
          "id": "anton_no_burn",
          "line": "文简把简册摞到自己铺头。灶再冷，字纸不进火——这是他的规矩，没人劝得动。",
          "silent": true,
          "once": "day",
          "effects": {
            "noBookFuel": true
          }
        }
      ],
      "arc": {
        "stages": [
          {
            "when": {
              "dayGte": 10
            },
            "line": "文简的《围城日录》写成第一卷。字很挤，纸很省。",
            "effects": {
              "items": {
                "book": 1
              },
              "memoirLine": "文简的日录第一卷写成了——围城第十天，他记的全是小事。"
            }
          },
          {
            "when": {
              "dayGte": 20
            },
            "line": "日录第二卷。这一卷开始记人：谁笑过，谁夜里咳嗽。",
            "effects": {
              "items": {
                "book": 1
              },
              "knowledge": 1,
              "memoirLine": "日录第二卷记的全是人。后来回忆录的骨，就是这两卷。"
            }
          },
          {
            "when": {
              "dayGte": 30
            },
            "line": "日录第三卷。他开始誊「还在的人的名字」——一笔一笔，像在跟谁对账。",
            "effects": {
              "items": {
                "book": 1
              },
              "mood": {
                "all": 1
              },
              "memoirLine": "第三卷誊的是还在的人的名字。名册他誊过一次，三十七个名字；这一次，他一个都不想再誊。"
            },
            "doneLine": "文简的日录三卷齐了。橘里的墙上后来多了一行小字：账不是这么算的——账是，他们还在。"
          }
        ]
      },
